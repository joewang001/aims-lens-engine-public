{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aims-lens-engine.local/schemas/agent_artifact.schema.json",
  "title": "Agentic Distillation Artifact",
  "type": "object",
  "required": [
    "artifact_id",
    "run_id",
    "agent_lane",
    "company",
    "company_slug",
    "source_files",
    "status",
    "coverage_status",
    "confidence",
    "extracted_signals",
    "source_trace",
    "human_review_required",
    "created_at"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "run_id": { "type": "string" },
    "agent_lane": { "type": "string" },
    "company": { "type": "string" },
    "company_slug": { "type": "string" },
    "source_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["ready_for_review", "needs_source", "blocked"]
    },
    "coverage_status": {
      "type": "string",
      "enum": ["complete", "partial", "missing"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "extracted_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_trace": {
      "type": "array",
      "items": { "type": "string" }
    },
    "human_review_required": { "type": "boolean" },
    "created_at": { "type": "string" }
  }
}
