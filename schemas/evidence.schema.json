{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aims-lens-engine.local/schemas/evidence.schema.json",
  "title": "Evidence Record",
  "type": "object",
  "required": [
    "evidence_id",
    "source_type",
    "title",
    "access_date",
    "confidence",
    "extracted_signals"
  ],
  "properties": {
    "evidence_id": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": [
        "official_company",
        "executive_primary",
        "job_description",
        "recruiting_material",
        "public_interview_experience",
        "employee_review",
        "news_or_case",
        "external_criticism",
        "company_provided_private"
      ]
    },
    "title": { "type": "string" },
    "url": { "type": ["string", "null"] },
    "document_id": { "type": ["string", "null"] },
    "publisher": { "type": ["string", "null"] },
    "publish_date": { "type": ["string", "null"], "format": "date" },
    "access_date": { "type": "string", "format": "date" },
    "region": { "type": ["string", "null"] },
    "role_family": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "license_or_use_note": { "type": ["string", "null"] },
    "extracted_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal", "summary", "aims_dimensions", "confidence"],
        "properties": {
          "signal": { "type": "string" },
          "summary": { "type": "string" },
          "aims_dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "structured_thinking",
                "analytical_problem_solving",
                "ownership_execution",
                "impact_results",
                "collaboration_communication",
                "growth_mindset"
              ]
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "candidate_evaluation_use": { "type": ["string", "null"] }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
