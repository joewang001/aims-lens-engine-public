{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aims-lens-engine.local/schemas/screening_report.schema.json",
  "title": "Screening Report",
  "type": "object",
  "required": [
    "report_id",
    "tenant_id",
    "candidate_id",
    "role",
    "lens_id",
    "lens_status",
    "aims_scores",
    "screening_recommendation",
    "confidence",
    "human_review_required",
    "evidence_notice"
  ],
  "properties": {
    "report_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "candidate_id": { "type": "string" },
    "role": { "type": "string" },
    "lens_id": { "type": "string" },
    "lens_status": {
      "type": "string",
      "enum": ["FULLY_DISTILLED", "DERIVED_LENS", "LIGHTWEIGHT_SCAN", "GENERIC_AIMS"]
    },
    "aims_scores": {
      "type": "object",
      "properties": {
        "structured_thinking": { "type": "number", "minimum": 0, "maximum": 10 },
        "analytical_problem_solving": { "type": "number", "minimum": 0, "maximum": 10 },
        "ownership_execution": { "type": "number", "minimum": 0, "maximum": 10 },
        "impact_results": { "type": "number", "minimum": 0, "maximum": 10 },
        "collaboration_communication": { "type": "number", "minimum": 0, "maximum": 10 },
        "growth_mindset": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "company_lens_adjustments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "strengths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_follow_ups": {
      "type": "array",
      "items": { "type": "string" }
    },
    "screening_recommendation": {
      "type": "string",
      "enum": ["advance", "hold", "reject", "human_review_required"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "human_review_required": { "type": "boolean" },
    "fairness_review_flags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_notice": { "type": "string" }
  }
}
