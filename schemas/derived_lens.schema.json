{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aims-lens-engine.local/schemas/derived_lens.schema.json",
  "title": "Derived Lens",
  "type": "object",
  "required": [
    "derived_lens_id",
    "target_company",
    "lens_status",
    "confidence",
    "inputs",
    "reference_lenses",
    "derived_aims_weighting",
    "limitations"
  ],
  "properties": {
    "derived_lens_id": { "type": "string" },
    "target_company": { "type": "string" },
    "lens_status": {
      "type": "string",
      "enum": ["DERIVED_LENS", "LIGHTWEIGHT_SCAN"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "inputs": {
      "type": "object",
      "properties": {
        "industry": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "job_description_present": { "type": "boolean" },
        "public_sources_used": { "type": "integer", "minimum": 0 },
        "enterprise_sources_used": { "type": "integer", "minimum": 0 }
      }
    },
    "reference_lenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lens_id", "weight", "reason"],
        "properties": {
          "lens_id": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string" }
        }
      }
    },
    "derived_aims_weighting": {
      "type": "object",
      "properties": {
        "structured_thinking": { "type": "number", "minimum": 0, "maximum": 1 },
        "analytical_problem_solving": { "type": "number", "minimum": 0, "maximum": 1 },
        "ownership_execution": { "type": "number", "minimum": 0, "maximum": 1 },
        "impact_results": { "type": "number", "minimum": 0, "maximum": 1 },
        "collaboration_communication": { "type": "number", "minimum": 0, "maximum": 1 },
        "growth_mindset": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "derived_hiring_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
